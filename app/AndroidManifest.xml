<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.idiotbox"
    android:versionCode="12"
    android:versionName="1.0.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- All Apps: Menu on an app asks Android to uninstall it (its own dialog confirms). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Without a TMDB key, the picks are what the TV's apps publish (Watch Next, preview channels): TvPicks. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Fire OS's TV provider shows other apps' rows only with this ("read all TV listings"); EPG_DATA alone: own rows. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Fire OS 6 refuses third-party accessibility services: FireTvKeeper reads the screen in front from UsageStats
         and moves our home task forward (tools/firetv.sh grants the app-op from a computer). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Fire OS 8 (Android 11): without this list the app can't "see" the other apps (getLeanbackLaunchIntentForPackage
         returns null). The shelf and streaming apps and, through the <intent>, every TV app (for "All Apps"). -->
    <queries>
        <!-- The music apps used when none is picked (MusicEngine.KNOWN): BitChord TV and Prism. -->
        <package android:name="com.music.bitchord.tv" />
        <package android:name="com.prism.music" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.firetv.youtube" />
        <package android:name="com.amazon.firebat" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.hbo.hbonow" />
        <package android:name="com.apple.atve.amazon.appletv" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.spotify.tv.android" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <!-- The music apps' media browsers: which ones share their music (MusicEngine.findProviders). -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:label="Idiot Box"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!-- The app's icon opens the settings (switch between Idiot Box and the original home screen). -->
        <activity
            android:name=".SettingsActivity"
            android:process=":home"
            android:exported="true"
            android:label="Idiot Box"
            android:launchMode="singleTask"
            android:taskAffinity="io.idiotbox.settings"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/IdiotBox.Sidebar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home screen. Its own process (:home): if it ever crashes, the safety net in the main process still
             works. Fire OS keeps Amazon's launcher as Home: FireTvService (Fire OS 7/8) or FireTvKeeper (Fire OS 6)
             opens this one over it in Idiot Box mode. -->
        <activity
            android:name=".HomeActivity"
            android:process=":home"
            android:exported="true"
            android:label="Idiot Box"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/IdiotBox.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".Screensaver"
            android:process=":home"
            android:enabled="@bool/dream_in_home"
            android:exported="true"
            android:label="Idiot Box"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The same screensaver on Android 11, in the main process (see ScreensaverAlone). -->
        <service
            android:name=".ScreensaverAlone"
            android:enabled="@bool/dream_alone"
            android:exported="true"
            android:label="Idiot Box"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The switches, as background jobs in the main process. -->
        <service
            android:name=".ModeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Opens our home screen when Amazon's comes up and closes the Alexa overlay, in Idiot Box mode (FireTv).
             Turned on once from a computer (tools/firetv.sh). -->
        <service
            android:name=".FireTvService"
            android:exported="true"
            android:label="Idiot Box"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fire_tv_service" />
        </service>

        <!-- Fire OS 6 only, where the accessibility service above is refused: UsageStats + moveTaskToFront. -->
        <service
            android:name=".FireTvKeeper"
            android:exported="false"
            android:label="Idiot Box" />

        <!-- Starts the keeper again after a reboot, when Idiot Box mode is on. Only on Fire OS 6 (API <= 27). -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="@bool/keeper_boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- What the music apps are playing, for the music screensaver: Android shares media sessions only with a
             notification listener. Reads no notifications. Access from a computer (NowPlaying). In :home, beside the
             home screen and the screensaver that read it (Music). -->
        <service
            android:name=".NowPlaying"
            android:process=":home"
            android:exported="true"
            android:label="Idiot Box"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The Music tab's search, with Idiot Box's own keyboard (MusicSearchActivity): no system keyboard. -->
        <activity
            android:name=".MusicSearchActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- The music screensaver: opened by the home screen while music plays (MusicSaverActivity). -->
        <activity
            android:name=".MusicSaverActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout" />

        <!-- Live TV: a channel full screen in Android's own player (Live, LiveSource). -->
        <activity
            android:name=".LivePlayerActivity"
            android:process=":home"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout" />

        <!-- The remote's Live TV button: links for Amazon's Live TV app (off in Idiot Box mode) open our home screen. -->
        <activity
            android:name=".LiveTvActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="livetv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="amzn" android:host="com.amazon.tv.livetv" />
            </intent-filter>
        </activity>

    </application>
</manifest>
